{
  "name": "goku-kamehameha",
  "displayName": "Goku Kamehameha",
  "description": "🐉 Goku fires a Kamehameha across your editor every time your code runs successfully!",
  "version": "2.2.3",
  "publisher": "daksh-gehlot",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Darksider70-yep/Goku"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.116.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "goku",
    "kamehameha",
    "dragon ball",
    "animation",
    "fun"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "goku.triggerKamehameha",
        "title": "🐉 Trigger Goku Kamehameha!"
      }
    ],
    "keybindings": [
      {
        "command": "goku.triggerKamehameha",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "Goku Kamehameha",
      "properties": {
        "goku.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Kamehameha animation globally"
        },
        "goku.animationDuration": {
          "type": "number",
          "default": 4500,
          "minimum": 1000,
          "maximum": 10000,
          "step": 500,
          "description": "Animation duration in milliseconds (1000-10000)"
        },
        "goku.soundEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable Kamehameha sound effects (Web Audio API synthesis)"
        },
        "goku.triggerOnTask": {
          "type": "boolean",
          "default": true,
          "description": "Trigger animation when a task completes successfully with exit code 0"
        },
        "goku.triggerOnDebug": {
          "type": "boolean",
          "default": true,
          "description": "Trigger animation when a debug session ends (success or stop)"
        },
        "goku.triggerOnTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Trigger animation when a supported code command succeeds in the integrated terminal (requires shell integration)"
        }
      }
    }
  },
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "package": "npx -y @vscode/vsce package --no-dependencies",
    "lint": "echo 'no linter configured'"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.116.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.0"
  }
}
